{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn"
  },
  "globals": {
    "CATEGORY_COLORS": "readonly",
    "DESIGN": "readonly",
    "hexToRgba": "readonly",
    "drawHexLobby": "readonly"
  }
}
